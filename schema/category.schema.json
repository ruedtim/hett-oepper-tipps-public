{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "category.schema.json",
  "title": "Kategorienliste",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "label", "emoji", "color", "active"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 30,
        "description": "Reines ASCII, damit Filter-Links nie URL-kodiert werden müssen. Unveränderlich — nur das Label wird umbenannt."
      },
      "label": { "type": "string", "minLength": 1, "maxLength": 30 },
      "emoji": { "type": "string", "minLength": 1, "maxLength": 8 },
      "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
      "active": {
        "type": "boolean",
        "description": "false statt löschen. Ein gelöschtes Kategorie-Kürzel würde alle Tipps verwaisen lassen, die es noch nennen."
      }
    }
  }
}
